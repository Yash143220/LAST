NODE_ENV=production
PORT=8080

# MongoDB connection string (Atlas free tier works)
MONGODB_URI=mongodb://127.0.0.1:27017/operation_outbreak

# Long random string:  openssl rand -hex 48
JWT_SECRET=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Add your site origin(s) under "Authorised JavaScript origins", e.g. https://play.example.com
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Comma-separated Google emails allowed into /admin (developer only)
ADMIN_EMAILS=you@gmail.com

# Number of reverse proxies in front of the app (1 for nginx/Caddy/Render/Fly). Needed for correct client IPs.
TRUST_PROXY=1

# Optional
# CLIENT_ORIGINS=http://localhost:5173      # extra allowed origins (dev only)
# MAX_ROOMS=500
# COOKIE_SECURE=true                        # default true in production
# ALLOW_DEV_LOGIN=false                     # never enable in production
